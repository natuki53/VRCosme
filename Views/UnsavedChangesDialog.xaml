<Window x:Class="VRCosme.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Dialog.UnsavedChanges.Title}"
        Width="560"
        Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        FontFamily="Segoe UI, Meiryo UI"
        FontSize="12">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="⚠"
                   FontSize="24"
                   VerticalAlignment="Top"
                   Margin="0,2,10,0"/>

        <TextBlock Grid.Row="0"
                   Grid.Column="1"
                   Text="{DynamicResource Dialog.UnsavedChanges.Message}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>

        <UniformGrid Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Rows="1"
                     Columns="3"
                     Margin="0,16,0,0">
            <Button Content="{DynamicResource Dialog.UnsavedChanges.ButtonSave}"
                    Style="{StaticResource AccentDialogButton}"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="SaveAndContinue_Click"/>
            <Button Content="{DynamicResource Dialog.UnsavedChanges.ButtonDiscard}"
                    Style="{StaticResource DialogButton}"
                    Margin="0,0,8,0"
                    Click="DiscardAndContinue_Click"/>
            <Button Content="{DynamicResource Dialog.UnsavedChanges.ButtonCancel}"
                    Style="{StaticResource DialogButton}"
                    IsCancel="True"
                    Click="Cancel_Click"/>
        </UniformGrid>
    </Grid>
</Window>
